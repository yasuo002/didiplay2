{{ 'didiplay-styles.css' | asset_url | stylesheet_tag }}
<section class="below-fold">
  <div class="container" style="max-width:820px">
    <div class="section-head reveal" style="margin-bottom:28px"><h1 style="margin:0">{{ page.title }}</h1></div>
    <div class="reveal rte" style="font-size:1.05rem;color:var(--body);line-height:1.7">{{ page.content }}</div>
  </div>
</section>
{% schema %}
{ "name": "Page content", "settings": [], "presets": [{ "name": "Page content" }] }
{% endschema %}
