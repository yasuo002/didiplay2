{{ 'didiplay-styles.css' | asset_url | stylesheet_tag }}
{{ 'didiplay-index.css' | asset_url | stylesheet_tag }}
<section id="reviews" class="reviews section-pink below-fold">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p><span class="stars">★★★★★</span> &nbsp; {{ section.settings.summary }}</p>
    </div>
    <div class="carousel" id="reviewCarousel" aria-roledescription="carousel">
      <button class="carousel-arrow prev" aria-label="Previous review">‹</button>
      <button class="carousel-arrow next" aria-label="Next review">›</button>
      <div class="carousel-viewport">
        <div class="carousel-track">
          {%- for block in section.blocks -%}
            <article class="review" {{ block.shopify_attributes }}>
              <div class="r-head">
                {%- if block.settings.avatar != blank -%}
                  {{ block.settings.avatar | image_url: width: 80 | image_tag: alt: block.settings.name, loading: 'lazy' }}
                {%- else -%}
                  <div style="width:48px;height:48px;border-radius:50%;background:var(--pink-wash);flex:0 0 auto"></div>
                {%- endif -%}
                <div>
                  <div class="r-name">{{ block.settings.name }}</div>
                  <div class="r-loc">{{ block.settings.location }}</div>
                </div>
                {%- if block.settings.verified -%}<span class="verified">Verified Buyer ✓</span>{%- endif -%}
              </div>
              <div class="stars" aria-label="5 out of 5">★★★★★</div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
              <div class="r-date">{{ block.settings.date }}</div>
            </article>
          {%- endfor -%}
        </div>
      </div>
      <div class="carousel-dots" id="reviewDots"></div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Reviews carousel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real Parents, Real Wins" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Parents Are Saying" },
    { "type": "text", "id": "summary", "label": "Summary", "default": "4.9 average from 2,318 verified reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Sarah M." },
        { "type": "text", "id": "location", "label": "Location", "default": "Austin, TX" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true },
        { "type": "text", "id": "title", "label": "Title", "default": "\"My 5-year-old is obsessed\"" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "He used to beg for my phone every afternoon. Now he runs to his drawing robot instead." },
        { "type": "text", "id": "date", "label": "Date", "default": "April 18, 2026" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review", "settings": { "name": "Sarah M.", "location": "Austin, TX", "title": "\"My 5-year-old is obsessed\"", "body": "He used to beg for my phone every afternoon. Now he runs to his drawing robot instead. Watching him trace the animals and color them in has done wonders for his focus.", "date": "April 18, 2026" } },
        { "type": "review", "settings": { "name": "Daniel K.", "location": "Manchester, UK", "title": "\"Finally, screen-free fun that sticks\"", "body": "We've tried a dozen educational toys that got ignored after a week. This one's been a daily ritual for two months. The cards keep it fresh.", "date": "March 30, 2026" } },
        { "type": "review", "settings": { "name": "Priya R.", "location": "Toronto, CA", "title": "\"Gift-winner of the year\"", "body": "Bought it for my niece's 6th birthday and it stole the whole party. Three other parents asked me where I got it before the cake was even cut.", "date": "March 12, 2026" } },
        { "type": "review", "settings": { "name": "Emma L.", "location": "Sydney, AU", "title": "\"You can see her confidence growing\"", "body": "She used to say I can't draw. Now she proudly shows me every crab and hippo she finishes and we stick them on the fridge.", "date": "February 27, 2026" } },
        { "type": "review", "settings": { "name": "Marcus T.", "location": "Berlin, DE", "title": "\"Sturdy, safe, and genuinely clever\"", "body": "Feels well made, no sharp bits, and the step-by-step drawing actually teaches technique. My son's pencil grip has improved noticeably in six weeks.", "date": "February 9, 2026" } }
      ]
    }
  ]
}
{% endschema %}
