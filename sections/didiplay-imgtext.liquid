{{ 'didiplay-product.css' | asset_url | stylesheet_tag }}
<section class="section-pink below-fold">
  <div class="container imgtxt">
    <div class="reveal">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: alt: section.settings.heading, loading: 'lazy', style: 'border-radius:20px;width:100%', widths: '400,720,800' }}
      {%- else -%}
        <div style="border-radius:20px;width:100%;aspect-ratio:7/5;background:linear-gradient(135deg,#FFD8E5,#FFE3EE);display:flex;align-items:center;justify-content:center;color:var(--pink);font-family:Sora,sans-serif;font-weight:800;font-size:1.5rem;text-align:center;padding:20px">{{ section.settings.placeholder | default: 'Step-by-Step Crab Demo' }}</div>
      {%- endif -%}
    </div>
    <div class="reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p style="font-size:1.1rem">{{ section.settings.body }}</p>
      <a href="{{ section.settings.cta_link | default: '#buySection' }}" class="btn btn-primary btn-lg">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder", "label": "Placeholder text", "default": "Step-by-Step Crab Demo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From scribble to skill" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Blank Page to Proud Smile" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Your child slots in a card, follows the robot's strokes, then colors it in themselves. Every finished drawing is a little win that builds confidence — and a lifelong love of creating." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Get Mine — 43% Off" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
