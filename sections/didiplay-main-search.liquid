{{ 'didiplay-styles.css' | asset_url | stylesheet_tag }}
<section class="below-fold">
  <div class="container" style="max-width:900px">
    <div class="section-head reveal" style="margin-bottom:28px"><h1 style="margin:0">Search</h1></div>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:10px;margin-bottom:32px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products…" style="flex:1;padding:14px 18px;border:1.5px solid var(--line);border-radius:999px;font-size:1rem">
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <article class="pcard reveal">
                <a href="{{ item.url }}" class="pcard-img">
                  {%- if item.featured_media -%}{{ item.featured_media | image_url: width: 600 | image_tag: alt: item.title, loading: 'lazy' }}{%- else -%}<div style="aspect-ratio:1/1;background:var(--pink-wash)"></div>{%- endif -%}
                </a>
                <div class="pcard-body">
                  <h3><a href="{{ item.url }}" style="color:inherit">{{ item.title }}</a></h3>
                  {%- if item.price -%}<div class="pcard-price"><span class="now price">{{ item.price | money }}</span></div>{%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p style="color:var(--body)">No results for “{{ search.terms | escape }}”. Try another search.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [], "presets": [{ "name": "Search" }] }
{% endschema %}
