{{ 'didiplay-index.css' | asset_url | stylesheet_tag }}
<section class="final-cta below-fold" id="shopify-section-{{ section.id }}-inner">
  <div class="container">
    <div class="cta-card reveal">
      {%- if section.settings.scarcity != blank -%}<div class="scarcity"><span class="pulse-dot"></span> {{ section.settings.scarcity }}</div>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-block-mob" style="background:#fff;color:var(--pink);font-size:1.15rem;padding:22px 38px;border-radius:999px;font-family:Sora,sans-serif;font-weight:800;display:inline-flex;align-items:center;gap:10px;box-shadow:0 20px 50px rgba(0,0,0,0.18)">{{ section.settings.cta_label }}</a>
      <p class="cta-sub">{{ section.settings.help_text }} <a href="{{ section.settings.help_link | default: '#' }}" style="color:#fff;text-decoration:underline">→ Chat with us</a></p>
      <div class="cta-trust">
        <span>🚚 Free shipping</span><span>·</span>
        <span>💖 30-day guarantee</span><span>·</span>
        <span>🔒 Secure checkout</span>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Final CTA",
  "settings": [
    { "type": "text", "id": "scarcity", "label": "Scarcity text", "default": "Only 11 left at this price" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Give the Gift of Creativity Today" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Hours of joyful, screen-free play — and a child who actually looks forward to drawing." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Claim My 43% Discount →" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "help_text", "label": "Help text", "default": "Got questions?" },
    { "type": "url", "id": "help_link", "label": "Help link" }
  ],
  "presets": [{ "name": "Final CTA" }]
}
{% endschema %}
