{{ 'didiplay-styles.css' | asset_url | stylesheet_tag }}
<style>
  .shop-head{ background:linear-gradient(135deg,#FFF1F6 0%,#F4EEFF 100%); padding:60px 0 50px; text-align:center; }
  .shop-head h1{ margin-bottom:10px; }
  .shop-head p{ font-size:1.08rem; color:var(--body); max-width:560px; margin:0 auto; }
  .shop-filters{ display:flex; justify-content:center; gap:8px; margin-top:28px; flex-wrap:wrap; }
  .filter-chip{ background:#fff; border:1.5px solid var(--line); padding:8px 18px; border-radius:999px; font-weight:600; font-size:.92rem; color:var(--ink); transition:.2s; }
  .filter-chip.active,.filter-chip:hover{ border-color:var(--pink); background:var(--pink); color:#fff; }
  .shop-section{ padding:56px 0 90px; }
  @media (max-width:768px){ .shop-head{ padding:40px 0 32px; } }
</style>

<section class="shop-head">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ section.settings.heading | default: collection.title }}</h1>
    <p>{{ section.settings.subheading }}</p>
  </div>
</section>

<section class="shop-section">
  <div class="container">
    <div class="product-grid" id="shopGrid">
      {%- assign prods = collection.products -%}
      {%- if prods == empty or prods.size == 0 -%}{%- assign prods = collections.all.products -%}{%- endif -%}
      {%- for product in prods -%}
        {%- assign v = product.selected_or_first_available_variant -%}
        <article class="pcard reveal">
          <a href="{{ product.url }}" class="pcard-img">
            {%- if product.compare_at_price > product.price -%}
              {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <span class="sale-badge">{{ pct }}% OFF</span>
            {%- endif -%}
            {%- if product.featured_media -%}
              {{ product.featured_media | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy', widths: '300,600' }}
            {%- else -%}
              <div style="aspect-ratio:1/1;background:#FFE3EE;display:flex;align-items:center;justify-content:center;color:#FF6B9D;font-family:Sora,sans-serif;font-weight:800;font-size:1.3rem;text-align:center;padding:14px">{{ product.title }}</div>
            {%- endif -%}
            <span class="quick-add">Quick View →</span>
          </a>
          <div class="pcard-body">
            <div class="pcard-rating"><span class="stars">★★★★★</span> {{ product.metafields.reviews.rating | default: '4.9' }}</div>
            <h3><a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a></h3>
            <div class="pcard-price">
              <span class="now price">{{ product.price | money }}</span>
              {%- if product.compare_at_price > product.price -%}<span class="was price">{{ product.compare_at_price | money }}</span>{%- endif -%}
            </div>
            <button class="btn btn-primary btn-block" style="margin-top:14px" data-didi-add="{{ v.id }}" data-qty="1" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
          </div>
        </article>
      {%- else -%}
        <p>No products yet. Add products to this collection in your Shopify admin.</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_banner -%}
    <div class="shop-banner reveal" style="margin-top:64px;background:linear-gradient(135deg,var(--pink) 0%,var(--purple) 100%);border-radius:32px;padding:40px;color:#fff;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap">
      <div>
        <h2 style="color:#fff;margin:0 0 6px;font-size:1.6rem">{{ section.settings.banner_heading }}</h2>
        <p style="color:rgba(255,255,255,.92);margin:0">{{ section.settings.banner_text }}</p>
      </div>
      <a href="{{ section.settings.banner_link | default: routes.all_products_collection_url }}" class="btn btn-lg" style="background:#fff;color:var(--pink)">{{ section.settings.banner_cta }}</a>
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The didiplay Collection" },
    { "type": "text", "id": "heading", "label": "Heading (blank = collection title)", "default": "All Products" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Carefully designed, parent-approved, and built to keep kids happily creating — screen-free." },
    { "type": "checkbox", "id": "show_banner", "label": "Show bundle banner", "default": true },
    { "type": "text", "id": "banner_heading", "label": "Banner heading", "default": "Bundle & save 15%" },
    { "type": "text", "id": "banner_text", "label": "Banner text", "default": "Get the Drawing Robot + 150-Card Mega Pack + Pen Refill together." },
    { "type": "text", "id": "banner_cta", "label": "Banner CTA", "default": "Build My Bundle →" },
    { "type": "url", "id": "banner_link", "label": "Banner link" }
  ],
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}
