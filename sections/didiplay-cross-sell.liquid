{{ 'didiplay-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign xp = all_products[section.settings.product]
  if xp == empty or xp == blank
    for p in collections.all.products
      if p.handle != product.handle and p.handle != 'shipping-protection'
        assign xp = p
        break
      endif
    endfor
  endif
-%}
<section class="below-fold didiplay-xsell">
  <div class="container">
    {%- if xp != empty and xp != blank -%}
    {%- assign xv = xp.selected_or_first_available_variant -%}
    <div class="xsell-card reveal">
      <div class="xsell-media">
        {%- if xp.featured_media -%}
          {{ xp.featured_media | image_url: width: 600 | image_tag: alt: xp.title, loading: 'lazy', widths: '300,600' }}
        {%- else -%}
          <div class="xsell-ph">{{ xp.title }}</div>
        {%- endif -%}
        {%- if xp.compare_at_price > xp.price -%}
          {%- assign xpct = xp.compare_at_price | minus: xp.price | times: 100.0 | divided_by: xp.compare_at_price | round -%}
          <span class="xsell-badge">{{ xpct }}% OFF</span>
        {%- endif -%}
      </div>
      <div class="xsell-body">
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        <h2>{{ section.settings.heading }}</h2>
        <p>{{ section.settings.body }}</p>
        <div class="xsell-meta">
          <span class="stars">★★★★★</span>
          <span class="xsell-name">{{ xp.title }}</span>
        </div>
        <div class="xsell-price">
          <span class="now price">{{ xp.price | money }}</span>
          {%- if xp.compare_at_price > xp.price -%}<span class="was price">{{ xp.compare_at_price | money }}</span>{%- endif -%}
        </div>
        <button type="button" class="btn btn-primary btn-lg pulse xsell-add" data-didi-add="{{ xv.id }}" data-qty="1" {% unless xp.available %}disabled{% endunless %}>
          {% if xp.available %}{{ section.settings.cta_label }}{% else %}Sold Out{% endif %}
        </button>
        <a href="{{ xp.url }}" class="xsell-link">View details →</a>
      </div>
    </div>
    {%- else -%}
      <div class="section-head reveal"><h2>{{ section.settings.heading }}</h2><p>Add a second product to your store to feature it here.</p></div>
    {%- endif -%}
  </div>
</section>
<style>
  .didiplay-xsell .xsell-card{ display:grid; grid-template-columns:1fr 1.1fr; gap:32px; align-items:center;
    background:linear-gradient(135deg,var(--purple-wash) 0%,var(--pink-wash) 100%); border-radius:28px; padding:32px; }
  .didiplay-xsell .xsell-media{ position:relative; }
  .didiplay-xsell .xsell-media img,.didiplay-xsell .xsell-ph{ width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:20px; }
  .didiplay-xsell .xsell-ph{ background:#F4EEFF; display:flex; align-items:center; justify-content:center; color:var(--purple); font-family:Sora,sans-serif; font-weight:800; font-size:1.4rem; text-align:center; padding:18px; }
  .didiplay-xsell .xsell-badge{ position:absolute; top:14px; left:14px; background:var(--pink); color:#fff; font-weight:800; font-size:.8rem; padding:6px 12px; border-radius:999px; }
  .didiplay-xsell .xsell-body h2{ font-size:1.7rem; margin:6px 0 10px; }
  .didiplay-xsell .xsell-body p{ color:var(--body); margin-bottom:14px; }
  .didiplay-xsell .xsell-meta{ display:flex; align-items:center; gap:8px; margin-bottom:8px; font-weight:600; color:var(--ink); }
  .didiplay-xsell .xsell-price{ display:flex; align-items:baseline; gap:10px; margin-bottom:18px; }
  .didiplay-xsell .xsell-price .now{ font-size:1.7rem; font-weight:800; color:var(--ink); }
  .didiplay-xsell .xsell-price .was{ text-decoration:line-through; color:var(--muted); }
  .didiplay-xsell .xsell-add{ width:100%; }
  .didiplay-xsell .xsell-link{ display:inline-block; margin-top:12px; color:var(--purple); font-weight:600; }
  @media (max-width:768px){ .didiplay-xsell .xsell-card{ grid-template-columns:1fr; gap:20px; padding:22px; } }
</style>
{% schema %}
{
  "name": "Product cross-sell",
  "settings": [
    { "type": "product", "id": "product", "label": "Product to feature (blank = auto-pick another)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Customers Also Add" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make It the Complete Kit" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Double the fun — pair the Drawing Robot with our most-loved add-on and keep little artists creating for months." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Add This Too →" }
  ],
  "presets": [{ "name": "Product cross-sell" }]
}
{% endschema %}
