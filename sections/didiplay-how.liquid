{{ 'didiplay-product.css' | asset_url | stylesheet_tag }}
<section class="below-fold didiplay-how">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="how-grid">
      {%- for block in section.blocks -%}
        <div class="how-step reveal" {{ block.shopify_attributes }}>
          <div class="how-num">{{ forloop.index }}</div>
          <div class="how-icon" style="background:{{ block.settings.icon_bg | default: '#FFF1F6' }}">{{ block.settings.icon }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .didiplay-how .how-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; counter-reset:step; }
  .didiplay-how .how-step{ position:relative; background:#fff; border:1px solid var(--line); border-radius:24px; padding:34px 26px 28px; text-align:center; box-shadow:var(--shadow-sm); }
  .didiplay-how .how-num{ position:absolute; top:-16px; left:50%; transform:translateX(-50%); width:38px; height:38px; border-radius:50%;
    background:linear-gradient(135deg,var(--pink),var(--purple)); color:#fff; font-family:Sora,sans-serif; font-weight:800;
    display:flex; align-items:center; justify-content:center; box-shadow:0 8px 20px rgba(124,58,237,.3); }
  .didiplay-how .how-icon{ width:64px; height:64px; border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:1.7rem; margin:8px auto 16px; }
  .didiplay-how .how-step h3{ font-size:1.15rem; margin-bottom:8px; }
  .didiplay-how .how-step p{ color:var(--body); font-size:.96rem; }
  @media (max-width:768px){ .didiplay-how .how-grid{ grid-template-columns:1fr; gap:30px; } }
</style>
{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Creating in Three Simple Steps" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "From the very first card to the hundredth drawing — it just works, beautifully." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🎴" },
        { "type": "text", "id": "icon_bg", "label": "Icon background", "default": "#FFF1F6" },
        { "type": "text", "id": "title", "label": "Title", "default": "Insert a Card, Watch the Magic" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Pop in any of the 150+ cards and the robot draws it instantly — no setup, no apps, no wait." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "🎴", "icon_bg": "#FFF1F6", "title": "Insert a Card, Watch the Magic", "body": "Pop in any of the 150+ cards and the robot draws it instantly — no setup, no apps, no wait." } },
        { "type": "step", "settings": { "icon": "📈", "icon_bg": "#F4EEFF", "title": "Grows With Your Child", "body": "From simple shapes to detailed animals, the difficulty scales as their skills grow." } },
        { "type": "step", "settings": { "icon": "🎁", "icon_bg": "#E0FAF2", "title": "Complete Creative Kit", "body": "Color pens, black pens, sticker sheets and a charging cable — ready out of the box." } }
      ]
    }
  ]
}
{% endschema %}
