{{ 'didiplay-product.css' | asset_url | stylesheet_tag }}
<section class="section-soft below-fold">
  <div class="container">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="ba-wrap reveal" id="baCompare">
      {%- if section.settings.after_image != blank -%}
        <img class="ba-img after" src="{{ section.settings.after_image | image_url: width: 1200 }}" alt="After">
      {%- else -%}
        <div class="ba-img after" style="background:#FFE3EE;display:flex;align-items:center;justify-content:center;color:#FF6B9D;font-family:Sora,sans-serif;font-weight:800;font-size:1.6rem;text-align:center;padding:20px">{{ section.settings.after_text | default: 'AFTER · Confident Finished Drawing' }}</div>
      {%- endif -%}
      <div class="ba-clip" id="baClip">
        {%- if section.settings.before_image != blank -%}
          <img class="ba-img before" src="{{ section.settings.before_image | image_url: width: 1200 }}" alt="Before">
        {%- else -%}
          <div class="ba-img before" style="background:#E8E4F0;display:flex;align-items:center;justify-content:center;color:#8B86A0;font-family:Sora,sans-serif;font-weight:800;font-size:1.6rem;text-align:center;padding:20px">{{ section.settings.before_text | default: 'BEFORE · First Scribble' }}</div>
        {%- endif -%}
      </div>
      <div class="ba-handle" id="baHandle"><span>‹ ›</span></div>
      <span class="ba-label left">Before</span>
      <span class="ba-label right">After</span>
    </div>
    {%- if section.settings.caption != blank -%}<p class="center" style="margin-top:18px;color:var(--body)">{{ section.settings.caption }}</p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Before / after",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Before & After" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "\"I can't draw\" → A wall full of proud creations" },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_text", "label": "Before placeholder", "default": "BEFORE · First Scribble" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_text", "label": "After placeholder", "default": "AFTER · Confident Finished Drawing" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Drag the handle to compare." }
  ],
  "presets": [{ "name": "Before / after" }]
}
{% endschema %}
