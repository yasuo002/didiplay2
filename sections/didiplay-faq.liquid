{{ 'didiplay-product.css' | asset_url | stylesheet_tag }}
<section id="faq" class="section-purple below-fold">
  <div class="container faq-wrap">
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    {%- if section.settings.show_search -%}
    <div class="faq-search reveal">
      <span>🔍</span>
      <input type="text" id="faqSearch" placeholder="Search the FAQ…" aria-label="Search FAQ">
    </div>
    {%- endif -%}
    <div class="faq-list" id="faqList">
      {%- for block in section.blocks -%}
        <details class="faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{{ block.settings.answer }}</p></details>
      {%- endfor -%}
    </div>
    <div class="faq-empty" id="faqEmpty" style="display:none">No questions matched — try a different word.</div>
  </div>
</section>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Can't find what you're looking for? We're here to help." },
    { "type": "checkbox", "id": "show_search", "label": "Show search box", "default": true }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What age is the Drawing Robot for?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Designed for children 5 and up. Younger kids enjoy it with light supervision." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What age is the Drawing Robot for?", "answer": "Designed for children 5 and up. Younger kids enjoy it with light supervision." } },
        { "type": "faq", "settings": { "question": "Does it need an app or screen?", "answer": "No. It's completely screen-free and app-free — just insert a card and play." } },
        { "type": "faq", "settings": { "question": "How many drawing cards are included?", "answer": "Over 150 illustrated cards across animals, plants, transport, food and more." } },
        { "type": "faq", "settings": { "question": "How is it powered?", "answer": "It recharges via the included USB cable — no constant battery buying." } },
        { "type": "faq", "settings": { "question": "What if my child doesn't love it?", "answer": "You're covered by our 30-day money-back guarantee, no questions asked." } },
        { "type": "faq", "settings": { "question": "Is it safe?", "answer": "Yes — made from child-safe materials with a rounded, kid-friendly design." } }
      ]
    }
  ]
}
{% endschema %}
